# Copy to .env.dev and keep the copy mode 0600. Never point this at a mutable
# production checkout; pin an asset release directory instead.
COMPOSE_PROJECT_NAME=nexpoly_dev
NEXPOLY_ASSET_ROOT=/path/to/nexpoly-assets/releases/<asset-digest>
NEXPOLY_DEV_BACKEND_PORT=18000
NEXPOLY_DEV_FRONTEND_PORT=15173
NEXPOLY_DEV_FRONTEND_BIND_ADDRESS=127.0.0.1
NEXPOLY_DEV_ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173
NEXPOLY_DEV_POSTGRES_PORT=15532
NEXPOLY_DEV_NGINX_PORT=19000
NEXPOLY_DEV_GPU_DEVICE=1

POLYTAO_ENABLED=true
MONOMER_MD_DEV_WORKER_ENABLED=false
MONOMER_MD_DEV_WORKER_SOCKET_DIR=./.runtime/monomer-md-worker-socket
MONOMER_MD_DEV_WORKER_JOB_ROOT=./.runtime/monomer-md-worker-runs
MONOMER_MD_DEV_WORKER_PYTHON=./.venv-monomer-md-worker/bin/python
MONOMER_MD_DEV_WORKER_BASE_PYTHON=/path/to/frozen-byteff2-base/bin/python
MONOMER_MD_DEV_WORKER_BASE_PYTHON_IDENTITY_SHA256=sha256:<base-python-identity>
# Optional: an offline directory containing every wheel from requirements.lock.
# MONOMER_MD_DEV_WORKER_WHEELHOUSE=/path/to/worker-wheelhouse
BYTEFF2_ROOT=/path/to/nexpoly-assets/releases/<asset-digest>/byteff2
