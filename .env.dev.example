# Copy to .env.dev and keep the copy mode 0600. Never point this at a mutable
# production checkout; pin an asset release directory instead.
COMPOSE_PROJECT_NAME=nexpoly_dev
NEXPOLY_ASSET_ROOT=/path/to/nexpoly-assets/releases/<asset-digest>
NEXPOLY_DEV_BACKEND_PORT=18000
NEXPOLY_DEV_FRONTEND_PORT=15173
NEXPOLY_DEV_FRONTEND_BIND_ADDRESS=127.0.0.1
NEXPOLY_DEV_ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173
# Optional independent OpenScience frontend. Leave empty for the syncing placeholder.
# Local browser: http://127.0.0.1:9011/
# Remote browser example: http://114.214.255.154:9011/
VITE_AGENT_WORKSPACE_URL=
NEXPOLY_DEV_GPU_LAUNCHER_ENABLED=false
NEXPOLY_DEV_POSTGRES_PORT=15532
NEXPOLY_DEV_NGINX_PORT=19000
NEXPOLY_DEV_GPU_DEVICE=1
# Put real values in the owner-private .env.dev.ai (mode 0600), never here.
# Tg assistant is independently configured and remains off until explicitly enabled.
TG_ASSISTANT_ENABLED=false
TG_ASSISTANT_API_KEY=
TG_ASSISTANT_BASE_URL=
TG_ASSISTANT_MODEL=gpt-5.6-terra
TG_ASSISTANT_IMAGE_MAX_BYTES=5242880
TG_ASSISTANT_REASONING_EFFORT=medium
TG_ASSISTANT_TRANSPORT=auto
# Applies to online knowledge, the generic assistant, and the Tg assistant.
# Leave empty for direct access. Legacy ONLINE_KNOWLEDGE_PROXY_URL is accepted
# for one release only when AI_PROXY_URL is empty.
AI_PROXY_URL=

POLYTAO_ENABLED=true
MONOMER_MD_DEV_WORKER_ENABLED=true
MONOMER_MD_DEV_WORKER_SOCKET_DIR=./.runtime/monomer-md-worker-socket
MONOMER_MD_DEV_WORKER_JOB_ROOT=./.runtime/monomer-md-worker-runs
MONOMER_MD_DEV_WORKER_PYTHON=./.venv-monomer-md-worker/bin/python
MONOMER_MD_DEV_WORKER_BASE_PYTHON=/path/to/frozen-byteff2-base/bin/python
MONOMER_MD_DEV_WORKER_BASE_PYTHON_IDENTITY_SHA256=sha256:<base-python-identity>
# Absolute OpenMM prefix containing the core CUDA plugin and the ByteFF2
# VelocityVerlet Transport plugin; worker-up validates all four native files.
MONOMER_MD_DEV_BYTEFF2_OPENMM_DIR=/path/to/frozen-byteff2-openmm/openmm
# Optional: an offline directory containing every wheel from requirements.lock.
# MONOMER_MD_DEV_WORKER_WHEELHOUSE=/path/to/worker-wheelhouse
BYTEFF2_ROOT=/path/to/nexpoly-assets/releases/<asset-digest>/byteff2

# Main :9001-style development backend DFT bridge. Both paths are fenced to
# these exact owner-private locations under the current worktree.
MONOMER_DFT_DEV_WORKER_SOCKET_DIR=./.runtime/monomer-dft-worker-socket
MONOMER_DFT_DEV_DOWNLOAD_SPOOL_DIR=./.runtime/monomer-dft-download-spool
