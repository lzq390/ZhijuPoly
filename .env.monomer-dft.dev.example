# Copy this file to .env.monomer-dft.dev. The real file is ignored by Git and Docker.
# Paths are resolved from the current clean NexPoly Git worktree root.

MONOMER_DFT_PYTHON=.runtime/venvs/monomer-dft-worker/bin/python
MONOMER_DFT_WORKER_UDS=.runtime/monomer-dft-worker-socket/worker.sock
MONOMER_DFT_JOB_ROOT=.runtime/monomer-dft-worker-runs
MONOMER_DFT_MAX_CONCURRENT_JOBS=1
MONOMER_DFT_MAX_QUEUED_JOBS=8
MONOMER_DFT_SINGLE_POINT_TIMEOUT_SECONDS=600
MONOMER_DFT_OPTIMIZATION_TIMEOUT_SECONDS=1800
# Exit 70 is restartable only within this bounded local supervisor budget.
MONOMER_DFT_FATAL_RESTART_MAX_ATTEMPTS=3
MONOMER_DFT_FATAL_RESTART_BACKOFF_SECONDS=1
MONOMER_DFT_FATAL_RESTART_MAX_BACKOFF_SECONDS=8
MONOMER_DFT_FATAL_RESTART_RESET_SECONDS=300
MONOMER_DFT_WORKER_TIMEOUT_SECONDS=15
MONOMER_DFT_RECONCILE_INTERVAL_SECONDS=1
MONOMER_DFT_ARTIFACT_RETENTION_DAYS=30
MONOMER_DFT_DRAIN_TIMEOUT_SECONDS=1800
# Backend isolates RDKit preparation from its default thread pool.
MONOMER_DFT_VALIDATION_CONCURRENCY=2
# Downloads are verified into private files before response headers are sent.
MONOMER_DFT_DOWNLOAD_MAX_CONCURRENT=2
# Compose bind-mounts the current worktree's private spool at this fixed
# container path. The backend creates a distinct 0700 process directory below
# it and removes stale, lease-free process directories during recovery.
MONOMER_DFT_DOWNLOAD_SPOOL_ROOT=/app/.runtime/monomer-dft-download-spool

# Dedicated development stack. Bindings stay on loopback. Set a new project
# name for a fresh acceptance run; Compose then creates a distinct project
# network and PostgreSQL volume instead of reusing the default development DB.
NEXPOLY_DFT_PROJECT_NAME=nexpoly_dft_dev
NEXPOLY_DFT_FRONTEND_PORT=25173
NEXPOLY_DFT_BACKEND_PORT=28000
NEXPOLY_DFT_POSTGRES_PORT=25532
NEXPOLY_DFT_POSTGRES_PASSWORD=nexpoly_dft_dev

# This delivery is development-only and rejects every other deployment mode.
# The HTTP supervisor is CPU-only. The resident executor sees physical GPU 1
# as cuda:0; a transient, single-model executor may use GPU 3 only when the
# primary execution lease is denied. Physical GPUs 0 and 2 are always rejected.
MONOMER_DFT_DEPLOYMENT=dev
NEXPOLY_DFT_GPU_DEVICE=1
NEXPOLY_DFT_OVERFLOW_GPU_DEVICES=3
MONOMER_DFT_GPU_BUDGET_MIB=4096
MONOMER_DFT_GPU_ACTIVE_THREAD_PERCENTAGE=50
# A local isolated smoke may run without the development Broker only when the
# standalone smoke flag is explicitly enabled.
MONOMER_DFT_GPU_BROKER_ENABLED=1
MONOMER_DFT_STANDALONE_GPU_SMOKE=0
MONOMER_DFT_GPU_BROKER_UDS=.runtime/gpu-resource/broker.sock
MONOMER_DFT_GPU_MPS_PIPE_ROOT=.runtime/gpu-resource
MONOMER_DFT_GPU_EXTERNAL_RESERVATIONS=.runtime/gpu-resource/external-reservations.json
CUDA_DEVICE_ORDER=PCI_BUS_ID

AIMNET_CACHE_DIR=.runtime/aimnet-cache
WARP_CACHE_PATH=.runtime/warp-cache
UV_CACHE_DIR=.runtime/uv-cache

# Read-only setup inputs. Populate the private standalone clone from the
# repository URL in the lock. Setup requires a clean HEAD at the exact locked
# commit/tree and builds only from its git archive.
AIMNET_SOURCE_CLONE=.runtime/aimnet-source-clone
AIMNET_SOURCE_DIR=.runtime/aimnet-source-archive
AIMNET_MODEL_SOURCE_DIR=/home/devuser/.cache/aimnet
AIMNET_SOURCE_LOCK=workers/monomer_dft_worker/aimnet-source.lock.json

PYTHONNOUSERSITE=1
PYTHONDONTWRITEBYTECODE=1
# Setup and launch scripts reject a non-empty inherited PYTHONPATH.
PYTHONPATH=
