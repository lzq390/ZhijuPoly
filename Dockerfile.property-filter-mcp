FROM python:3.11-slim@sha256:e031123e3d85762b141ad1cbc56452ba69c6e722ebf2f042cc0dc86c47c0d8b3

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend

WORKDIR /app
COPY backend/requirements-property-filter-mcp.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/requirements.lock
COPY backend/app /app/backend/app

# Compose uses the invoking user's UID/GID so the private bind-mounted files
# remain mode 0600. The image itself also defaults to an unprivileged identity.
USER 1001:1001
EXPOSE 18110
CMD ["python", "-m", "app.property_filter_mcp"]
