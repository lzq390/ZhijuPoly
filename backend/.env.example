# Archived SQLite sources are only used by import_postgres.py and postgres_preflight.py --mode migration.
LEGACY_MAIN_SQLITE_SOURCE_PATH=backend/data/archive/legacy-sqlite-YYYYMMDD-HHMMSS/polyprop.db
LEGACY_PI_SQLITE_SOURCE_PATH=backend/data/archive/legacy-sqlite-YYYYMMDD-HHMMSS/pi_reverse_design.db
LEGACY_DFT_SQLITE_SOURCE_PATH=backend/data/archive/legacy-sqlite-YYYYMMDD-HHMMSS/fumol.db
CSV_SOURCE_PATH=database/data1.csv
EXPERIMENTAL_PROCESS_CSV_PATH=database/polymer_process_material_filtered_cleaned_office_utf8_bom.csv
EXPERIMENTAL_PROPERTY_CSV_PATH=database/polymer_property_detail_cleaned_office_utf8_bom.csv
KNOWLEDGE_ZIP_PATH=database/data_txt.zip
FUMOL_ZIP_PATH=D:/database/fumol/FuMolDatabase.zip
# Legacy import helpers only; not used by the Postgres runtime.
SQLITE_DB_PATH=backend/data/polyprop.db
FUMOL_DB_PATH=backend/data/fumol.db
PI_REVERSE_DB_PATH=backend/data/pi_reverse_design.db
PI_REVERSE_CSV_PATH=
STRUCTURED_DATA_BACKEND=postgres
# Supply environment-specific DSNs from a mode-0600 local secret file. Never
# commit a reusable database username/password pair to this template.
APP_POSTGRES_DSN=
PI_REVERSE_BACKEND=postgres
PI_POSTGRES_DSN=
LAB_DATA_POSTGRES_DSN=
PI_REVERSE_TG_WINDOW_CELSIUS=50
PI_REVERSE_TG_MAX_WINDOW_CELSIUS=200
PI_REVERSE_MAX_SCAN_ROWS=500000
PI_REVERSE_TIMEOUT_SECONDS=30
PI_REVERSE_JOB_WORKERS=1
PI_REVERSE_JOB_BATCH_SIZE=20000
PI_REVERSE_PROGRESS_INTERVAL_ROWS=50000
STRUCTURE_3D_TIMEOUT_SECONDS=8
MONOMER_MD_WORKER_BASE_URL=
MONOMER_MD_WORKER_TIMEOUT_SECONDS=30
MONOMER_MD_DEFAULT_STEPS=300
MONOMER_MD_SUBMIT_ENABLED=true
MONOMER_MD_RATE_LIMIT_PER_IP_PER_MINUTE=3
MONOMER_MD_RATE_LIMIT_WINDOW_SECONDS=60
MONOMER_MD_MAX_ACTIVE_JOBS=1
# Monomer DFT submission remains disabled until its separately authorized
# production enablement. Historical reads do not require a Worker socket.
MONOMER_DFT_SUBMIT_ENABLED=false
MONOMER_DFT_WORKER_BASE_URL=http://monomer-dft-worker
MONOMER_DFT_WORKER_UDS=
MONOMER_DFT_WORKER_TIMEOUT_SECONDS=30
MONOMER_DFT_MAX_ACTIVE_JOBS=9
MONOMER_DFT_RECONCILE_INTERVAL_SECONDS=2
MONOMER_DFT_ARTIFACT_RETENTION_DAYS=30
MONOMER_DFT_VALIDATION_CONCURRENCY=2
MONOMER_DFT_DOWNLOAD_MAX_CONCURRENT=2
MONOMER_DFT_DOWNLOAD_SPOOL_ROOT=/tmp/monomer-dft-downloads
ONLINE_KNOWLEDGE_API_KEY=
ONLINE_KNOWLEDGE_BASE_URL=https://api.vectorengine.ai/v1
ONLINE_KNOWLEDGE_MODEL=gpt-4.1-nano-2025-04-14
ONLINE_KNOWLEDGE_MAX_PAPERS=20
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=gpt-5.5
ASSISTANT_IMAGE_MAX_BYTES=5242880
MODEL_DIR=model
MODEL_ENABLED=true
# The GPU scheduler and in-memory job store are process-local.
WEB_CONCURRENCY=1
OCSR_ENABLED=true
# Directory containing swin_base_char_aux_1m.pth, or the checkpoint file itself.
OCSR_MODEL_DIR=model/ocsr
OCSR_DEVICE=auto
OCSR_MAX_IMAGE_BYTES=5242880
GEN_MODEL_ENABLED=false
GEN_MODEL_DIR=model/conditional_generation
GEN_DEVICE=auto
GEN_JOB_WORKERS=1
GEN_MAX_ACTIVE_JOBS=8
GPU_PRELOAD_MODE=lazy
GPU_MAX_CONCURRENT_INFERENCES=1
GPU_MAX_WAITING_INFERENCES=8
GPU_SYNC_QUEUE_TIMEOUT_SECONDS=30
GPU_ASYNC_QUEUE_TIMEOUT_SECONDS=600
POLYTAO_ENABLED=true
POLYTAO_MODEL_DIR=model/polytao
POLYTAO_DEVICE=auto
POLYTAO_JOB_THREADS=1
POLYTAO_MAX_ACTIVE_JOBS=1
RETRO_MODEL_ENABLED=true
RETRO_MODEL_ID=model/reactiont5-retrosynthesis
RETRO_DEVICE=auto
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9000,http://127.0.0.1:9000
