# No real credentials, enabled sales, or default commercial price.
# Mount actual secret files read-only at the absolute paths configured below.
NEXPOLY_BILLING_ENABLED=false
NEXPOLY_BILLING_REGISTRATION_ENABLED=false
NEXPOLY_BILLING_MONTHLY_PRICE_FEN=
NEXPOLY_BILLING_PROVIDERS=

# To configure this channel, list wechat in NEXPOLY_BILLING_PROVIDERS.
NEXPOLY_WECHAT_APP_ID=
NEXPOLY_WECHAT_MERCHANT_ID=
NEXPOLY_WECHAT_MERCHANT_SERIAL=
NEXPOLY_WECHAT_PRIVATE_KEY_FILE=
NEXPOLY_WECHAT_API_V3_KEY_FILE=
NEXPOLY_WECHAT_PLATFORM_KEY_ID=
NEXPOLY_WECHAT_PLATFORM_PUBLIC_KEY_FILE=
NEXPOLY_WECHAT_NOTIFY_URL=https://payments.example.invalid/api/v1/billing/webhooks/wechat

# To configure this channel, list alipay in NEXPOLY_BILLING_PROVIDERS.
NEXPOLY_ALIPAY_APP_ID=
NEXPOLY_ALIPAY_SELLER_ID=
NEXPOLY_ALIPAY_PRIVATE_KEY_FILE=
NEXPOLY_ALIPAY_PUBLIC_KEY_FILE=
NEXPOLY_ALIPAY_NOTIFY_URL=https://payments.example.invalid/api/v1/billing/webhooks/alipay
