{
  "name": "polyprop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run --config vite.config.ts",
    "test:structure-browser": "node scripts/verify-structure-workspace.mjs",
    "test:structure-resources": "node scripts/verify-structure-resources.mjs",
    "postinstall": "patch-package --error-on-fail && node scripts/verify-ketcher-patches.mjs",
    "verify:ketcher-patches": "node scripts/verify-ketcher-patches.mjs",
    "prebuild": "npm run verify:ketcher-patches",
    "dev:ketcher-compat": "vite --host 127.0.0.1 --port 5188 --strictPort --config vite.ketcher-compat.config.ts",
    "build:ketcher-compat": "tsc -b && vite build --config vite.ketcher-compat.config.ts",
    "preview:ketcher-compat": "vite preview --host 127.0.0.1 --port 4187 --strictPort --config vite.ketcher-compat.config.ts",
    "test:ketcher-compat": "node scripts/verify-ketcher-compat.mjs",
    "prebuild:ketcher-compat": "npm run verify:ketcher-patches",
    "test:ketcher-worker": "node --test scripts/verify-ketcher-worker.mjs",
    "test:structure-ai": "node scripts/verify-structure-ai.mjs",
    "test:structure-engines": "node scripts/verify-structure-engines.mjs",
    "test:structure-refresh": "node scripts/verify-structure-refresh-performance.mjs"
  },
  "dependencies": {
    "3dmol": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ketcher-core": "3.8.0",
    "ketcher-macromolecules": "3.8.0",
    "ketcher-react": "3.8.0",
    "ketcher-standalone": "3.8.0",
    "lucide-react": "^0.542.0",
    "pako": "^2.1.0",
    "process": "0.11.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "5.0.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "1.8.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "compression": "1.8.1",
    "jsdom": "^26.1.0",
    "patch-package": "8.0.1",
    "playwright": "1.63.0",
    "postcss": "^8.5.6",
    "react-test-renderer": "19.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^4.1.10"
  }
}
