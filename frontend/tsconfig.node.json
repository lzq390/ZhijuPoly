{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "target": "ES2022",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vite.ketcher-compat.config.ts",
    "build/**/*.ts"
  ]
}
