# Install as app.env with mode 0600. Application/API credentials belong here,
# never in Compose, manifests, release archives, or workflow logs.
ONLINE_KNOWLEDGE_API_KEY=
# Optional shared proxy for online knowledge, the generic assistant, and the
# Tg assistant. It must be an absolute HTTP(S) URL without credentials.
AI_PROXY_URL=
# Tg assistant credentials are independent. Keep the feature disabled until
# all three provider values have been installed and smoke-tested.
TG_ASSISTANT_ENABLED=false
TG_ASSISTANT_API_KEY=
TG_ASSISTANT_BASE_URL=
TG_ASSISTANT_MODEL=gpt-5.6-terra
TG_ASSISTANT_IMAGE_MAX_BYTES=5242880
TG_ASSISTANT_REASONING_EFFORT=medium
TG_ASSISTANT_TRANSPORT=auto
# Automatic record retention remains opt-in until the production inventory
# and backup review are complete.
MONOMER_MD_JOB_RETENTION_ENABLED=false
MONOMER_MD_JOB_RETENTION_DAYS=30
MONOMER_DFT_JOB_RETENTION_ENABLED=false
MONOMER_DFT_JOB_RETENTION_DAYS=30
