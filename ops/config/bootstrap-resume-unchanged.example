#!/usr/bin/env bash
set -euo pipefail
umask 077

production_root=/data/lzq/gith/nexpoly
runtime_root=/data/lzq/gith/nexpoly-runtime
resume="$runtime_root/config/bootstrap-legacy-runtime-resume-unchanged"
validator="$runtime_root/legacy-takeover/bin/site_helper_contracts.py"
: "${NEXPOLY_BOOTSTRAP_LEGACY_RUNTIME_SHA256:?set the audited legacy runtime digest}"

[[ "$PWD" == "$production_root" ]] || {
  echo "bootstrap unchanged resume must run from $production_root" >&2
  exit 2
}
for executable in "$resume" "$validator"; do
  [[ -f "$executable" && ! -L "$executable" && -x "$executable" ]] || {
    echo "install the source-pinned unchanged-resume contract first" >&2
    exit 2
  }
  [[ "$(stat -c '%u:%a' "$executable")" == "$(id -u):700" ]] || {
    echo "legacy resume executable must be deploy-user-owned mode 0700" >&2
    exit 2
  }
done

# Only the exact stopped Web container may be started. Backend process and
# user Worker invocation must remain byte-for-byte/identity unchanged.
evidence="$(mktemp)"
trap 'rm -f "$evidence"' EXIT
"$resume" >"$evidence"
[[ -s "$evidence" && "$(stat -c '%s' "$evidence")" -le 65536 ]] || {
  echo "legacy unchanged-resume evidence is empty or too large" >&2
  exit 2
}

/usr/bin/python3 -I -B "$validator" validate \
  --helper bootstrap-legacy-runtime-resume-unchanged \
  --input "$evidence" \
  --expected-runtime-digest "$NEXPOLY_BOOTSTRAP_LEGACY_RUNTIME_SHA256"
