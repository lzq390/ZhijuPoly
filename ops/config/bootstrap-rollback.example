#!/usr/bin/env bash
set -euo pipefail
umask 077

production_root=/data/lzq/gith/nexpoly
runtime_root=/data/lzq/gith/nexpoly-runtime
restore="$runtime_root/config/bootstrap-legacy-runtime-restore"
validator="$runtime_root/legacy-takeover/bin/site_helper_contracts.py"
: "${NEXPOLY_BOOTSTRAP_LEGACY_RUNTIME_SHA256:?set the audited legacy runtime digest}"

[[ "$PWD" == "$production_root" ]] || {
  echo "bootstrap rollback must run from $production_root" >&2
  exit 2
}
for executable in "$restore" "$validator"; do
  [[ -f "$executable" && ! -L "$executable" && -x "$executable" ]] || {
    echo "install the source-pinned legacy restore contract first" >&2
    exit 2
  }
  [[ "$(stat -c '%u:%a' "$executable")" == "$(id -u):700" ]] || {
    echo "legacy restore executable must be deploy-user-owned mode 0700" >&2
    exit 2
  }
done

# The exact takeover restore must already have returned HTTPS, ignored paths,
# Worker unit metadata and prior controls. This helper then starts only the
# sealed containers/user unit and restores ingress.
evidence="$(mktemp)"
trap 'rm -f "$evidence"' EXIT
"$restore" >"$evidence"
[[ -s "$evidence" && "$(stat -c '%s' "$evidence")" -le 65536 ]] || {
  echo "legacy runtime restore evidence is empty or too large" >&2
  exit 2
}

/usr/bin/python3 -I -B "$validator" validate \
  --helper bootstrap-legacy-runtime-restore \
  --input "$evidence" \
  --expected-runtime-digest "$NEXPOLY_BOOTSTRAP_LEGACY_RUNTIME_SHA256"
