#!/usr/bin/env bash
set -euo pipefail
umask 077

production_root=/data/lzq/gith/nexpoly
runtime_root=/data/lzq/gith/nexpoly-runtime
status_probe="$runtime_root/config/bootstrap-legacy-runtime-status"
validator="$runtime_root/legacy-takeover/bin/site_helper_contracts.py"
: "${NEXPOLY_BOOTSTRAP_LEGACY_RUNTIME_SHA256:?set the audited legacy runtime digest}"

[[ "$PWD" == "$production_root" ]] || {
  echo "bootstrap status must run from $production_root" >&2
  exit 2
}
for executable in "$status_probe" "$validator"; do
  [[ -f "$executable" && ! -L "$executable" && -x "$executable" ]] || {
    echo "install the source-pinned legacy status contract first" >&2
    exit 2
  }
  [[ "$(stat -c '%u:%a' "$executable")" == "$(id -u):700" ]] || {
    echo "legacy status executable must be deploy-user-owned mode 0700" >&2
    exit 2
  }
done

# The site probe is read-only. Schema-v2 evidence binds both containers,
# entrypoint/command digests, the user Worker manager/unit, and PostgreSQL.
evidence="$(mktemp)"
trap 'rm -f "$evidence"' EXIT
"$status_probe" >"$evidence"
[[ -s "$evidence" && "$(stat -c '%s' "$evidence")" -le 65536 ]] || {
  echo "legacy status evidence is empty or too large" >&2
  exit 2
}

/usr/bin/python3 -I -B "$validator" validate \
  --helper bootstrap-legacy-runtime-status \
  --input "$evidence" \
  --expected-runtime-digest "$NEXPOLY_BOOTSTRAP_LEGACY_RUNTIME_SHA256"
