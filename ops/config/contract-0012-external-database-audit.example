#!/usr/bin/env bash
set -euo pipefail
umask 077

# Install this template as the fixed deploy-user-owned mode-0700 site helper.
# The source-pinned builder discovers the complete reviewed boundary and
# creates fresh evidence; this wrapper never accepts caller-selected roots,
# media IDs, Docker resources, restore flags, or audit images.
runtime_root=/data/lzq/gith/nexpoly-runtime
authority_rules_file="$runtime_root/config/postgres-media-authority-rules.json"
builder="$runtime_root/bin/nexpoly-postgres-media-evidence"

expected_authority_sha256=${NEXPOLY_CONTRACT_0012_MEDIA_AUTHORITY_RULES_SHA256:-}
[[ "$expected_authority_sha256" =~ ^sha256:[0-9a-f]{64}$ ]] || {
  echo "the prepared bridge must pin full PostgreSQL media authority rules" >&2
  exit 2
}

for private_file in "$authority_rules_file"; do
  [[ -f "$private_file" && ! -L "$private_file" ]] || {
    echo "private PostgreSQL audit input is unavailable: $private_file" >&2
    exit 2
  }
  [[ "$(/usr/bin/stat -c '%u:%a' "$private_file")" == "$(/usr/bin/id -u):600" ]] || {
    echo "$private_file must be deploy-user-owned mode 0600" >&2
    exit 2
  }
done
[[ "$(/usr/bin/sha256sum "$authority_rules_file" | /usr/bin/cut -d' ' -f1)" == "${expected_authority_sha256#sha256:}" ]] || {
  echo "private PostgreSQL media authority rules differ from bridge policy" >&2
  exit 2
}
[[ -x "$builder" && ! -L "$builder" ]] || {
  echo "source-pinned PostgreSQL media builder is unavailable" >&2
  exit 2
}
[[ "$(/usr/bin/stat -c '%u:%a' "$builder")" == "$(/usr/bin/id -u):700" ]] || {
  echo "source-pinned PostgreSQL media builder is unsafe" >&2
  exit 2
}

case "$#" in
  0)
    mode=build
    ;;
  1)
    [[ "$1" == revalidate ]] || {
      echo "only the fixed revalidate mode is accepted" >&2
      exit 2
    }
    mode=revalidate
    ;;
  *)
    echo "external PostgreSQL audit accepts at most one fixed mode" >&2
    exit 2
    ;;
esac

if [[ "$mode" == build ]]; then
  exec "$builder"
fi
exec "$builder" revalidate
