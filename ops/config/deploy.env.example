# Install as /data/lzq/gith/nexpoly/ops/config/deploy.env with mode 0600.
# Values below are placeholders; bootstrap_release_root.py never writes secrets.
NEXPOLY_POSTGRES_USER=polyprop
NEXPOLY_POSTGRES_PASSWORD=<rotate-to-a-random-password>
NEXPOLY_POSTGRES_DB=nexpoly
APP_POSTGRES_DSN=postgresql://polyprop:<url-encoded-password>@lab-postgres:5432/nexpoly
PI_POSTGRES_DSN=postgresql://polyprop:<url-encoded-password>@lab-postgres:5432/nexpoly
LAB_DATA_POSTGRES_DSN=postgresql://polyprop:<url-encoded-password>@lab-postgres:5432/nexpoly
NEXPOLY_ASSET_ROOT=/data/lzq/gith/nexpoly/ops/current-assets
# The asset digest comes only from the verified release manifest; do not
# configure a second asset-digest source here.
# PolyTAO is part of the Backend release and its real generation smoke is a
# mandatory production gate; the standalone PolyTAO Worker is not used.
POLYTAO_ENABLED=true
POLYTAO_JOB_THREADS=1
# This deploy-only gate is normalized once by release_controller and is never
# inherited by the Worker. When true, candidate, Worker, Backend status, and
# Backend protocols must all prove strict Transport readiness.
MONOMER_MD_REQUIRE_TRANSPORT_READY=true
# The managed symlink target's ASSET-MANIFEST.json records byteff2_commit.
NEXPOLY_WORKER_BASE_PYTHON=/home/devuser/miniconda3/envs/byteff2-repro/bin/python
NEXPOLY_WORKER_CONDA_EXE=/home/devuser/miniconda3/bin/conda
NEXPOLY_WORKER_GMX=/home/devuser/miniconda3/envs/byteff2-repro/bin/gmx
# Generate this after freezing the Conda environment with:
# python3 scripts/release_controller.py worker-base-identity \
#   --python /path/to/frozen/byteff2/bin/python
NEXPOLY_WORKER_BASE_PYTHON_IDENTITY_SHA256=sha256:<64-lowercase-hex>
NEXPOLY_MIN_FREE_BYTES=10737418240
# Normal releases always use the persistent deployment-control table and the
# complete eight-category Backend status. Custom drain/job hooks are forbidden.
NEXPOLY_DRAIN_TIMEOUT_SECONDS=1800
# Required only for `maintain-contract-0012 --apply`. The command must be one
# deploy-user-owned mode-0700 executable with no arguments. It inventories the
# independent dev/health PostgreSQL stacks using read-only, non-privileged roles
# and prints the exact JSON contract documented in postgres-migration-governance.md,
# including the unique production/nexpoly writable_target binding.
# NEXPOLY_CONTRACT_0012_EXTERNAL_DATABASE_AUDIT_COMMAND=/data/lzq/gith/nexpoly/ops/config/contract-0012-external-database-audit
# NEXPOLY_CONTRACT_0012_DEV_AUDIT_USER=nexpoly_dev_auditor
# NEXPOLY_CONTRACT_0012_MD_HEALTH_AUDIT_USER=nexpoly_health_auditor
NEXPOLY_HEALTH_URLS=http://127.0.0.1:9000/health
# First release only. The quiesce hook must isolate public ingress and print one
# JSON object (and nothing else on stdout):
# {"active_jobs_schema_version":1,"ingress_isolated":true,"active_jobs":{"monomer_md":0,"polytao":0,"online_knowledge":0,"conditional_generation":0,"reverse_design":0,"gpu_inference":0,"gpu_waiting":0,"inflight_api_writes":0},"active_total":0}
# The rollback hook must be idempotent and restore the legacy runtime and ingress
# even when quiesce exits nonzero or prints invalid/incomplete evidence.
# NEXPOLY_BOOTSTRAP_RELEASE_SHA=<40-lowercase-hex>
# NEXPOLY_BOOTSTRAP_QUIESCE_COMMAND=/data/lzq/gith/nexpoly/ops/config/bootstrap-quiesce
# NEXPOLY_BOOTSTRAP_ROLLBACK_COMMAND=/data/lzq/gith/nexpoly/ops/config/bootstrap-rollback
# NEXPOLY_BOOTSTRAP_LEGACY_RUNTIME_SHA256=sha256:<canonical-legacy-runtime-identity>
