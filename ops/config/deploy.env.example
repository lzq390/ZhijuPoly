# Install as /data/lzq/gith/nexpoly-runtime/config/deploy.env with mode 0600.
# Values below are placeholders; runtime bootstrap never writes secrets.
NEXPOLY_RUNTIME_ROOT=/data/lzq/gith/nexpoly-runtime
NEXPOLY_APP_ENV_FILE=/data/lzq/gith/nexpoly-runtime/config/app.env
NEXPOLY_GPU_STATE_ROOT=/data/lzq/gith/nexpoly-runtime/state/gpu-resource
NEXPOLY_POSTGRES_USER=polyprop
NEXPOLY_POSTGRES_PASSWORD=<rotate-to-a-random-password>
NEXPOLY_POSTGRES_DB=nexpoly
NEXPOLY_POSTGRES_PORT=55432
APP_POSTGRES_DSN=postgresql://polyprop:<url-encoded-password>@lab-postgres:5432/nexpoly
PI_POSTGRES_DSN=postgresql://polyprop:<url-encoded-password>@lab-postgres:5432/nexpoly
LAB_DATA_POSTGRES_DSN=postgresql://polyprop:<url-encoded-password>@lab-postgres:5432/nexpoly
NEXPOLY_ASSET_ROOT=/data/lzq/gith/nexpoly-runtime/state/current-assets
# The target asset digest comes only from the verified pull-deployment record;
# do not configure a second asset-digest source here.
# PolyTAO is part of the Backend release and its real generation smoke is a
# mandatory production gate; the standalone PolyTAO Worker is not used.
POLYTAO_ENABLED=true
POLYTAO_JOB_THREADS=1
# This deploy-only gate is normalized once by the pull-deploy controller and is never
# inherited by the Worker. When true, candidate, Worker, Backend status, and
# Backend protocols must all prove strict Transport readiness.
MONOMER_MD_REQUIRE_TRANSPORT_READY=true
# The external managed asset pointer's ASSET-MANIFEST.json records byteff2_commit.
NEXPOLY_WORKER_BASE_PYTHON=/home/devuser/miniconda3/envs/byteff2-repro/bin/python
NEXPOLY_WORKER_CONDA_EXE=/home/devuser/miniconda3/bin/conda
NEXPOLY_WORKER_GMX=/home/devuser/miniconda3/envs/byteff2-repro/bin/gmx
# Generate this after freezing the Conda environment with:
# python3 scripts/release_controller.py worker-base-identity \
#   --python /path/to/frozen/byteff2/bin/python
NEXPOLY_WORKER_BASE_PYTHON_IDENTITY_SHA256=sha256:<64-lowercase-hex>
NEXPOLY_MIN_FREE_BYTES=10737418240
# Pinned capacity for the network-isolated PostgreSQL 16 restore rehearsal.
# The controller also requires at least max(8 GiB, 8x dump size) and caps it
# at 256 GiB.
NEXPOLY_POSTGRES_RESTORE_TMPFS_BYTES=8589934592
# Normal releases always use the persistent deployment-control table and the
# complete eight-category Backend status. Custom drain/job hooks are forbidden.
NEXPOLY_DRAIN_TIMEOUT_SECONDS=1800
# Required before the reviewed pull-state 0012 maintenance adapter may run. The
# retired bundle controller cannot consume it. The command must be one deploy-user-owned
# mode-0700 executable with no arguments. It inventories the independent
# dev/health PostgreSQL stacks using read-only, non-privileged roles and prints
# the exact JSON contract documented in postgres-migration-governance.md,
# including the unique production/nexpoly writable_target binding.
# NEXPOLY_CONTRACT_0012_EXTERNAL_DATABASE_AUDIT_COMMAND=/data/lzq/gith/nexpoly-runtime/config/contract-0012-external-database-audit
# NEXPOLY_CONTRACT_0012_DEV_AUDIT_USER=nexpoly_dev_auditor
# NEXPOLY_CONTRACT_0012_MD_HEALTH_AUDIT_USER=nexpoly_health_auditor
# Raw SHA-256 of the private, complete media registry consumed by that helper.
# The same digest is sealed into the prepared bridge descriptor/current state.
# NEXPOLY_CONTRACT_0012_MEDIA_REGISTRY_SHA256=sha256:<64 lowercase hex>
NEXPOLY_HEALTH_URLS=http://127.0.0.1:9000/health
# Before the first governed release, install eight fixed-name,
# deploy-user-owned mode-0700 executables in this config directory. Every
# deployment seals their hashes, so retain them through the complete rollback
# window and until a later reviewed controller contract explicitly retires
# them. Command selector variables are intentionally unsupported.
#
# Reviewed wrappers:
# /data/lzq/gith/nexpoly-runtime/config/bootstrap-quiesce
# /data/lzq/gith/nexpoly-runtime/config/bootstrap-status
# /data/lzq/gith/nexpoly-runtime/config/bootstrap-resume-unchanged
# /data/lzq/gith/nexpoly-runtime/config/bootstrap-rollback
#
# Site-specific helpers:
# /data/lzq/gith/nexpoly-runtime/config/bootstrap-active-jobs-probe
# /data/lzq/gith/nexpoly-runtime/config/bootstrap-legacy-runtime-status
# /data/lzq/gith/nexpoly-runtime/config/bootstrap-legacy-runtime-resume-unchanged
# /data/lzq/gith/nexpoly-runtime/config/bootstrap-legacy-runtime-restore
#
# The quiesce wrapper isolates public ingress and prints one JSON object (and
# nothing else on stdout):
# {"active_jobs_schema_version":1,"ingress_isolated":true,"active_jobs":{"monomer_md":0,"polytao":0,"online_knowledge":0,"conditional_generation":0,"reverse_design":0,"gpu_inference":0,"gpu_waiting":0,"inflight_api_writes":0},"active_total":0}
# Status is read-only. Unchanged-resume may restore only ingress and must prove
# Backend/Worker process identity is unchanged. Full rollback must be
# crash-idempotent and restore the audited legacy images, Worker unit and
# ingress even after a lost response.
# NEXPOLY_BOOTSTRAP_LEGACY_RUNTIME_SHA256=sha256:<canonical-legacy-runtime-identity>
