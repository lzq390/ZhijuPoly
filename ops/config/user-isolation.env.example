# Development only. Provision separate login roles after 0017; keep passwords
# in an owner-private runtime environment file, never in this tracked example.
# For dev_server_gpu.sh, save as .env.dev.auth (0600), explicitly enable
# NEXPOLY_DEV_USER_ISOLATION_ENABLED=true, and use lab-postgres:5432 for the
# five container DSNs below. The MD host DSN remains loopback.
APP_POSTGRES_DSN=postgresql://nexpoly_dev_api:<password>@127.0.0.1:5432/nexpoly_dev
AUTH_POSTGRES_DSN=postgresql://nexpoly_dev_auth:<password>@127.0.0.1:5432/nexpoly_dev
APP_SERVICE_POSTGRES_DSN=postgresql://nexpoly_dev_service:<password>@127.0.0.1:5432/nexpoly_dev
AUTH_ADMIN_POSTGRES_DSN=postgresql://<migrator>:<password>@127.0.0.1:5432/nexpoly_dev
AUTH_RESTORE_TEST_DSN=postgresql://<migrator>:<password>@127.0.0.1:5432/<empty_restore_database>
AUTH_AUDIT_POSTGRES_DSN=postgresql://nexpoly_dev_audit:<password>@127.0.0.1:5432/nexpoly_dev
AUTH_COOKIE_NAME=nexpoly_dev_session
AUTH_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional explicit 9001 development HTTP access. Every value must also appear
# in ALLOWED_ORIGINS. Leave empty for loopback-only development or HTTPS.
# AUTH_DEV_HTTP_ORIGINS=http://<development-host>:9001
AUTH_DEV_HTTP_ORIGINS=
# One Backend process. The existing Broker/lease/fencing settings remain required
# when running GPU calculations. Do not reuse any production Broker credentials.
WEB_CONCURRENCY=1
MONOMER_DFT_START_AUTHORIZATION_TOKEN=<at-least-32-random-bytes>
# DFT Worker only; keep it away from the public proxy.
MONOMER_DFT_START_AUTHORIZATION_URL=http://127.0.0.1:18000
# MD/batch Worker connections use the service login, never the API login.
# Use the existing Worker-specific DSN setting for that service credential.
MONOMER_MD_DEV_SERVICE_POSTGRES_DSN=postgresql://nexpoly_dev_service:<password>@127.0.0.1:15532/nexpoly_dev
# Backups must use the same PostgreSQL major version as the server.
POSTGRES_BIN=/usr/lib/postgresql/16/bin
