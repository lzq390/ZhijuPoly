# Install as /data/lzq/gith/nexpoly-runtime/config/worker.env with mode 0600.
# The pull-deploy controller prepares the inactive A/B venv; configuration
# never selects a slot.
APP_POSTGRES_DSN=postgresql://polyprop:<url-encoded-password>@127.0.0.1:55432/nexpoly
# This directory must contain BYTEFF2-COMMIT matching ASSET-MANIFEST.json's
# byteff2_commit; the release controller records that commit in release state.
BYTEFF2_ROOT=/data/lzq/gith/nexpoly-runtime/state/current-assets/byteff2
BYTEFF2_PYTHON=/home/devuser/miniconda3/envs/byteff2-repro/bin/python
# This native root is read-only. The Worker derives OPENMM_DIR,
# OPENMM_PLUGIN_DIR, and LD_LIBRARY_PATH for its own child processes; those
# derived variables are forbidden in worker.env.
BYTEFF2_OPENMM_DIR=/home/devuser/miniconda3/envs/byteff2-repro/byteff2_openmm/openmm
PYTHONPATH=/data/lzq/gith/nexpoly:/data/lzq/gith/nexpoly-runtime/state/current-assets/byteff2:/data/lzq/gith/nexpoly-runtime/state/current-assets/byteff2/submodules/bytemol
MONOMER_MD_JOB_ROOT=/data/lzq/gith/nexpoly-runtime/state/monomer-md-worker-runs
MONOMER_MD_WORKER_UDS=/data/lzq/gith/nexpoly-runtime/state/monomer-md-worker-socket/worker.sock
MONOMER_MD_WORKER_ID=monomer-md-production-worker
MONOMER_MD_WORKER_MODE=real
MONOMER_MD_MAX_ACTIVE_JOBS=3
MONOMER_MD_MAX_CONCURRENT_JOBS=1
MONOMER_MD_DEFAULT_STEPS=300
MONOMER_MD_MAX_STEPS=300
MONOMER_MD_TRANSPORT_CUDA_SMOKE_ENABLED=true
NEXPOLY_GPU_DEVICE=2
# Installed capability only; production stays disabled until its maintenance PR.
MONOMER_MD_GPU_BROKER_ENABLED=false
# Broker mode is supported only by the host user-systemd Worker. Compose
# hard-codes Broker-disabled and never receives the host user bus/cgroup.
MONOMER_MD_GPU_SCOPE_LAUNCHER=systemd-user-scope
MONOMER_MD_GPU_BROKER_ENVIRONMENT=prod
MONOMER_MD_GPU_BROKER_SOCKET_PATH=/data/lzq/gith/nexpoly-runtime/state/gpu-resource/broker.sock
MONOMER_MD_GPU_MPS_PIPE_ROOT=/data/lzq/gith/nexpoly-runtime/state/gpu-resource
MONOMER_MD_GPU_BROKER_WAIT_TIMEOUT_SECONDS=600
MONOMER_MD_GPU_BROKER_HEARTBEAT_INTERVAL_SECONDS=5
