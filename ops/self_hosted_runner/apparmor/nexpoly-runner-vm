#include <tunables/global>

profile nexpoly-runner-vm flags=(attach_disconnected) {
  #include <abstractions/base>
  /usr/bin/python3* rix,
  /usr/bin/qemu-system-x86_64 rix,
  /usr/{lib,lib64,share}/** r,
  /usr/lib/**.so* mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/local/libexec/nexpoly-runner/** r,
  /etc/nexpoly-runner/config.toml r,
  /etc/{ld.so.cache,nsswitch.conf,passwd,group,host.conf,hosts,resolv.conf,gai.conf,localtime} r,
  /run/systemd/resolve/** r,
  /etc/ssl/certs/** r,
  /dev/kvm rw,
  /dev/{null,zero,random,urandom} rw,
  /proc/{cpuinfo,meminfo,modules,stat,uptime,version,loadavg} r,
  /proc/sys/{kernel,vm}/** r,
  owner /proc/*/{stat,status,maps,smaps,limits,auxv,cmdline,comm,mountinfo,oom_score_adj} rw,
  owner /proc/*/task/** rw,
  owner /proc/*/fd/** rw,
  /sys/devices/system/** r,
  /sys/module/** r,
  /sys/fs/cgroup/** r,
  /sys/bus/** r,
  /etc/machine-id r,
  @STATE@/templates/** r,
  # QEMU takes shared read locks on the root-owned sealed backing image.
  @STATE@/templates/base-*.qcow2 rk,
  @STATE@/instances/** r,
  owner @STATE@/instances/** rwk,
  owner /run/nexpoly-runner-vm-*/** rwk,
  owner /tmp/** rwk,
  network inet stream,
  network inet dgram,
  network netlink raw,
  network unix stream,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=nexpoly-runner-vm,
  deny /etc/nexpoly-runner/app.pem r,
  deny /{,var/}run/docker.sock rw,
  deny /home/** rwklx,
  deny /root/** rwklx,
}
