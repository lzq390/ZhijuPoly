# Copy to /data/lzq/gith/nexpoly/.env.monomer-md-worker and replace secrets.
# systemd EnvironmentFile does not perform shell-style $VAR/${VAR} expansion.
# Keep every native-library path below fully expanded and absolute.

MONOMER_MD_PYTHON=/home/devuser/miniconda3/envs/byteff2-repro/bin/python
BYTEFF2_PYTHON=/home/devuser/miniconda3/envs/byteff2-repro/bin/python
APP_POSTGRES_DSN=postgresql://polyprop:CHANGE_ME@127.0.0.1:55432/nexpoly
BYTEFF2_ROOT=/data/lzq/gith/byteff2
PYTHONPATH=/data/lzq/gith/byteff2:/data/lzq/gith/byteff2/submodules/bytemol

BYTEFF2_OPENMM_DIR=/home/devuser/miniconda3/envs/byteff2-repro/byteff2_openmm/openmm
OPENMM_DIR=/home/devuser/miniconda3/envs/byteff2-repro/byteff2_openmm/openmm
OPENMM_PLUGIN_DIR=/home/devuser/miniconda3/envs/byteff2-repro/byteff2_openmm/openmm/lib/plugins
LD_LIBRARY_PATH=/home/devuser/miniconda3/envs/byteff2-repro/byteff2_openmm/openmm/lib:/home/devuser/miniconda3/envs/byteff2-repro/byteff2_openmm/openmm/lib/plugins

MONOMER_MD_JOB_ROOT=/data/lzq/monomer-md-worker-runs
MONOMER_MD_WORKER_UDS=/data/lzq/monomer-md-worker-socket/worker.sock
MONOMER_MD_WORKER_MODE=real
MONOMER_MD_WORKER_HOST=172.27.0.1
MONOMER_MD_WORKER_HEALTH_HOST=172.27.0.1
MONOMER_MD_WORKER_PORT=18010
MONOMER_MD_HEALTH_PROBE_TIMEOUT_SECONDS=30
MONOMER_MD_MAX_CONCURRENT_JOBS=1
MONOMER_MD_MAX_ACTIVE_JOBS=1
MONOMER_MD_TRANSPORT_CUDA_SMOKE_ENABLED=true
NEXPOLY_GPU_DEVICE=2
