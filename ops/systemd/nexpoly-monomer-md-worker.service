[Unit]
Description=NexPoly monomer MD worker
After=network-online.target nexpoly-gpu-broker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/lzq/gith/nexpoly
# worker.env is intentionally not a systemd EnvironmentFile. The stable,
# owner-only helper accepts one strict literal syntax shared with candidate
# preflight and never evaluates configuration as shell code.
UnsetEnvironment=BASH_ENV BASHOPTS BASH_XTRACEFD CUDA_DEVICE_ORDER CUDA_VISIBLE_DEVICES ENV LD_AUDIT LD_LIBRARY_PATH LD_PRELOAD NVIDIA_VISIBLE_DEVICES OPENMM_DIR OPENMM_PLUGIN_DIR PS4 PYTHONHOME PYTHONINSPECT PYTHONSTARTUP PYTHONUSERBASE SHELLOPTS VIRTUAL_ENV NEXPOLY_ALLOW_TEST_ROOT NEXPOLY_RUNTIME_ROOT NEXPOLY_ACTIVE_CONTROL_ROOT NEXPOLY_ACTIVE_CONTROL_RELEASE_ID NEXPOLY_MONOMER_MD_ENV_SANITIZED
# A marker with no controller holding deploy.lock is a crashed deployment and
# must fail closed. During a controlled switch the controller still holds the
# lock, so the replacement Worker may start before release verification.
ExecStartPre=/usr/bin/bash -c '/usr/bin/test ! -L "$1" && /usr/bin/test -f "$2" && /usr/bin/test ! -L "$2" && /usr/bin/test "$(/usr/bin/stat -c %%u:%%a "$2")" = "$(/usr/bin/id -u):600" && { /usr/bin/test ! -e "$1" || ! /usr/bin/flock -n "$2" /usr/bin/true; }' _ /data/lzq/gith/nexpoly-runtime/state/deploy-in-progress.json /data/lzq/gith/nexpoly-runtime/state/deploy.lock
ExecStartPre=/usr/bin/test -x /data/lzq/gith/nexpoly-runtime/bin/control_runtime_selector.py
ExecStartPre=/usr/bin/test -r /data/lzq/gith/nexpoly-runtime/state/active-control.json
ExecStartPre=/usr/bin/test -x /home/devuser/miniconda3/envs/byteff2-repro/bin/gmx
ExecStartPre=/usr/bin/test -d /data/lzq/gith/nexpoly-runtime/state/current-assets/byteff2
ExecStartPre=/usr/bin/test -d /data/lzq/gith/nexpoly-runtime/state/monomer-md-worker-socket
ExecStartPre=/usr/bin/test -d /data/lzq/gith/nexpoly-runtime/state/monomer-md-worker-runs
ExecStart=/usr/bin/python3 -I -B /data/lzq/gith/nexpoly-runtime/bin/control_runtime_selector.py run monomer-md
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexpoly-monomer-md-worker
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
