#!/usr/bin/python3 -I
"""Immutable router for the active PostgreSQL media control release."""

import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys


if not sys.flags.isolated:
    raise SystemExit(
        "nexpoly-postgres-media-evidence requires isolated Python"
    )


def read_private_json(path: Path, *, mode: int) -> tuple[dict, bytes]:
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        before = os.fstat(descriptor)
        payload = os.read(descriptor, 16 * 1024 * 1024 + 1)
        after = os.fstat(descriptor)
        os.close(descriptor)
        document = json.loads(payload.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise SystemExit(
            f"nexpoly-postgres-media-evidence cannot read {path.name}"
        ) from exc
    if (
        len(payload) > 16 * 1024 * 1024
        or not stat.S_ISREG(before.st_mode)
        or before.st_uid != os.geteuid()
        or stat.S_IMODE(before.st_mode) != mode
        or before.st_nlink != 1
        or (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
            before.st_ctime_ns,
        )
        != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        )
        or not isinstance(document, dict)
    ):
        raise SystemExit(
            f"nexpoly-postgres-media-evidence rejects unsafe {path.name}"
        )
    return document, payload


authority_name = (
    "NEXPOLY_CONTRACT_0012_MEDIA_AUTHORITY_RULES_SHA256"
)
role_sql_name = "NEXPOLY_CONTRACT_0012_AUDIT_ROLE_SQL_SHA256"
launcher_name = "NEXPOLY_MEDIA_LAUNCHER_SHA256"
implementation_name = "NEXPOLY_MEDIA_IMPLEMENTATION_SHA256"

binary_root = Path(__file__).resolve().parent
runtime_root = binary_root.parent
active, _active_payload = read_private_json(
    runtime_root / "state/active-control.json",
    mode=0o600,
)
release_id = active.get("release_id")
if not isinstance(release_id, str) or re.fullmatch(
    r"[0-9a-f]{64}",
    release_id,
) is None:
    raise SystemExit(
        "nexpoly-postgres-media-evidence active control is invalid"
    )
release_root = runtime_root / "control-releases" / release_id
try:
    release_metadata = release_root.lstat()
except OSError as exc:
    raise SystemExit(
        "nexpoly-postgres-media-evidence active release is unavailable"
    ) from exc
if (
    not stat.S_ISDIR(release_metadata.st_mode)
    or release_root.is_symlink()
    or release_metadata.st_uid != os.geteuid()
    or stat.S_IMODE(release_metadata.st_mode) != 0o700
):
    raise SystemExit(
        "nexpoly-postgres-media-evidence active release is unsafe"
    )
manifest, manifest_payload = read_private_json(
    release_root / "CONTROL-MANIFEST.json",
    mode=0o600,
)
files = manifest.get("files")
manifest_digest = "sha256:" + hashlib.sha256(manifest_payload).hexdigest()
if (
    manifest.get("release_id") != release_id
    or active.get("manifest_sha256") != manifest_digest
    or not isinstance(files, dict)
):
    raise SystemExit(
        "nexpoly-postgres-media-evidence active manifest differs"
    )
derived_digests = {
    authority_name: files.get(
        "postgres-media-authority-rules.json",
        {},
    ).get("sha256"),
    role_sql_name: files.get(
        "postgres-media-audit-role.sql.example",
        {},
    ).get("sha256"),
    launcher_name: files.get(
        "postgres_media_launcher.py",
        {},
    ).get("sha256"),
    implementation_name: files.get(
        "postgres_media_evidence.py",
        {},
    ).get("sha256"),
}
if any(
    not isinstance(value, str)
    or re.fullmatch(r"sha256:[0-9a-f]{64}", value) is None
    or os.environ.get(name) not in {None, value}
    for name, value in derived_digests.items()
):
    raise SystemExit(
        "nexpoly-postgres-media-evidence media authority differs from active control"
    )
authority_digest = derived_digests[authority_name]
role_sql_digest = derived_digests[role_sql_name]
launcher_digest = derived_digests[launcher_name]
implementation_digest = derived_digests[implementation_name]
authority_path = runtime_root / "state/bootstrap-control.json"
try:
    authority_descriptor = os.open(
        authority_path,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    authority_metadata = os.fstat(authority_descriptor)
    authority_payload = os.read(authority_descriptor, 16 * 1024 * 1024 + 1)
    os.close(authority_descriptor)
    authority = json.loads(authority_payload.decode("utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as exc:
    raise SystemExit(
        "nexpoly-postgres-media-evidence lacks bootstrap authority"
    ) from exc
immutable = (
    authority.get("immutable_files")
    if isinstance(authority, dict)
    else None
)
expected_selector = (
    immutable.get("control_runtime_selector.py")
    if isinstance(immutable, dict)
    else None
)
if (
    len(authority_payload) > 16 * 1024 * 1024
    or not stat.S_ISREG(authority_metadata.st_mode)
    or authority_metadata.st_uid != os.geteuid()
    or stat.S_IMODE(authority_metadata.st_mode) != 0o600
    or authority_metadata.st_nlink != 1
    or not isinstance(authority, dict)
    or authority.get("schema_version") != 2
    or authority.get("status") != "completed"
    or not isinstance(expected_selector, str)
    or re.fullmatch(r"sha256:[0-9a-f]{64}", expected_selector)
    is None
    or immutable.get("nexpoly-postgres-media-evidence")
    != "sha256:" + hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
):
    raise SystemExit(
        "nexpoly-postgres-media-evidence bootstrap authority is invalid"
    )

bootstrap_active = authority.get("active_control")
bootstrap_release_id = (
    bootstrap_active.get("release_id")
    if isinstance(bootstrap_active, dict)
    else None
)
if not isinstance(bootstrap_release_id, str) or re.fullmatch(
    r"[0-9a-f]{64}",
    bootstrap_release_id,
) is None:
    raise SystemExit(
        "nexpoly-postgres-media-evidence bootstrap F control is invalid"
    )
bootstrap_release_root = (
    runtime_root / "control-releases" / bootstrap_release_id
)
try:
    bootstrap_release_metadata = bootstrap_release_root.lstat()
except OSError as exc:
    raise SystemExit(
        "nexpoly-postgres-media-evidence bootstrap F release is unavailable"
    ) from exc
if (
    not stat.S_ISDIR(bootstrap_release_metadata.st_mode)
    or bootstrap_release_root.is_symlink()
    or bootstrap_release_metadata.st_uid != os.geteuid()
    or stat.S_IMODE(bootstrap_release_metadata.st_mode) != 0o700
):
    raise SystemExit(
        "nexpoly-postgres-media-evidence bootstrap F release is unsafe"
    )
bootstrap_manifest, bootstrap_manifest_payload = read_private_json(
    bootstrap_release_root / "CONTROL-MANIFEST.json",
    mode=0o600,
)
bootstrap_files = bootstrap_manifest.get("files")
bootstrap_manifest_digest = (
    "sha256:" + hashlib.sha256(bootstrap_manifest_payload).hexdigest()
)
if (
    bootstrap_manifest.get("release_id") != bootstrap_release_id
    or bootstrap_active.get("manifest_sha256")
    != bootstrap_manifest_digest
    or not isinstance(bootstrap_files, dict)
):
    raise SystemExit(
        "nexpoly-postgres-media-evidence bootstrap F manifest differs"
    )
bootstrap_digests = {
    authority_name: bootstrap_files.get(
        "postgres-media-authority-rules.json",
        {},
    ).get("sha256"),
    role_sql_name: bootstrap_files.get(
        "postgres-media-audit-role.sql.example",
        {},
    ).get("sha256"),
    launcher_name: bootstrap_files.get(
        "postgres_media_launcher.py",
        {},
    ).get("sha256"),
    implementation_name: bootstrap_files.get(
        "postgres_media_evidence.py",
        {},
    ).get("sha256"),
}
if bootstrap_digests != derived_digests:
    raise SystemExit(
        "nexpoly-postgres-media-evidence active controls differ from bootstrap F authority"
    )
authority_digest = bootstrap_digests[authority_name]
role_sql_digest = bootstrap_digests[role_sql_name]
launcher_digest = bootstrap_digests[launcher_name]
implementation_digest = bootstrap_digests[implementation_name]

binary_descriptor = os.open(
    binary_root,
    os.O_RDONLY
    | os.O_DIRECTORY
    | getattr(os, "O_CLOEXEC", 0)
    | getattr(os, "O_NOFOLLOW", 0),
)
try:
    selector_descriptor = os.open(
        "control_runtime_selector.py",
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
        dir_fd=binary_descriptor,
    )
finally:
    os.close(binary_descriptor)
selector_metadata = os.fstat(selector_descriptor)
selector_digest = hashlib.sha256()
selector_size = 0
while True:
    chunk = os.read(selector_descriptor, 1024 * 1024)
    if not chunk:
        break
    selector_digest.update(chunk)
    selector_size += len(chunk)
    if selector_size > 16 * 1024 * 1024:
        raise SystemExit("control selector exceeds its size limit")
selector_after = os.fstat(selector_descriptor)
if (
    not stat.S_ISREG(selector_metadata.st_mode)
    or selector_metadata.st_uid != os.geteuid()
    or stat.S_IMODE(selector_metadata.st_mode) != 0o700
    or selector_metadata.st_nlink != 1
    or (
        selector_metadata.st_dev,
        selector_metadata.st_ino,
        selector_metadata.st_size,
        selector_metadata.st_mtime_ns,
        selector_metadata.st_ctime_ns,
    )
    != (
        selector_after.st_dev,
        selector_after.st_ino,
        selector_after.st_size,
        selector_after.st_mtime_ns,
        selector_after.st_ctime_ns,
    )
    or "sha256:" + selector_digest.hexdigest() != expected_selector
):
    raise SystemExit("control selector differs from bootstrap authority")
os.lseek(selector_descriptor, 0, os.SEEK_SET)
os.set_inheritable(selector_descriptor, True)
selector = f"/proc/self/fd/{selector_descriptor}"
python = "/usr/bin/python3"
if not sys.argv[1:]:
    routed_arguments = ["build"]
elif sys.argv[1:] in (["revalidate"], ["role-plan"]):
    routed_arguments = list(sys.argv[1:])
elif (
    len(sys.argv[1:]) == 3
    and sys.argv[1] == "provision-roles"
    and sys.argv[2] == "--confirm-plan-sha256"
    and re.fullmatch(r"sha256:[0-9a-f]{64}", sys.argv[3]) is not None
):
    routed_arguments = list(sys.argv[1:])
else:
    raise SystemExit(
        "nexpoly-postgres-media-evidence accepts only build, revalidate, "
        "role-plan, or an exact confirmed provision-roles invocation"
    )
os.execve(
    python,
    [
        python,
        "-I",
        "-B",
        selector,
        "run",
        "postgres-media-evidence",
        *routed_arguments,
    ],
    {
        "HOME": "/home/devuser",
        "USER": "devuser",
        "LOGNAME": "devuser",
        "PATH": "/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PYTHONDONTWRITEBYTECODE": "1",
        authority_name: authority_digest,
        role_sql_name: role_sql_digest,
        launcher_name: launcher_digest,
        implementation_name: implementation_digest,
    },
)
