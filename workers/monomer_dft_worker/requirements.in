# Monomer DFT worker runtime, excluding AIMNet itself. AIMNet is installed separately
# from the non-editable wheel pinned by aimnet-source.lock.json.
#
# Regenerate on Linux x86_64 with exactly uv 0.11.21:
# uv pip compile workers/monomer_dft_worker/requirements.in \
#   --python /usr/bin/python3.12 \
#   --python-version 3.12 \
#   --python-platform x86_64-unknown-linux-gnu \
#   --torch-backend cu128 \
#   --generate-hashes \
#   --output-file workers/monomer_dft_worker/requirements.lock \
#   --custom-compile-command 'uv 0.11.21; Python 3.12; Linux x86_64; torch backend cu128'

