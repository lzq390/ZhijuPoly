log engine.log
units real
atom_style full
boundary p p p

pair_style lj/cut 3.0 
kspace_style none 
dielectric 1.000000
bond_style harmonic
angle_style harmonic
dihedral_style fourier
improper_style cvff
special_bonds amber
pair_modify mix arithmetic
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
read_data input.data


thermo_style custom step time temp press enthalpy etotal ke pe ebond eangle edihed eimp evdwl ecoul elong etail vol lx ly lz density pxx pyy pzz pxy pxz pyz
thermo_modify flush yes
thermo 1000

comm_modify cutoff 8.000000
dump xtc0 all xtc 1000 trajectory.xtc
dump_modify xtc0 unwrap yes
restart 10000 radon_md_1.rst radon_md_2.rst

undump xtc0
min_style cg
minimize 0.000100 0.000001 10000 100000
reset_timestep 0
dump xtc0 all xtc 1000 trajectory.xtc
dump_modify xtc0 unwrap yes

timestep 0.100000

# nvt
fix md2 all nvt temp 300.000000 300.000000 100.000000

# Update thermo_style
thermo_style custom step time temp press enthalpy etotal ke pe ebond eangle edihed eimp evdwl ecoul elong etail vol lx ly lz density pxx pyy pzz pxy pxz pyz
thermo_modify flush yes
thermo 1000

run 20000
unfix md2

timestep 1.000000
fix shake3 all shake 1e-4 1000 0 m 1.0

# nvt
fix md3 all nvt temp 300.000000 700.000000 100.000000

# Update thermo_style
thermo_style custom step time temp press enthalpy etotal ke pe ebond eangle edihed eimp evdwl ecoul elong etail vol lx ly lz density pxx pyy pzz pxy pxz pyz
thermo_modify flush yes
thermo 1000

run 1000000
unfix md3
unfix shake3

timestep 1.000000
fix shake4 all shake 1e-4 1000 0 m 1.0

# deform
fix DEF4 all deform 1 x final -22.950210 22.950210 y final -22.950210 22.950210 z final -22.950210 22.950210 remap v

# nvt
fix md4 all nvt temp 700.000000 700.000000 100.000000

# Update thermo_style
thermo_style custom step time temp press enthalpy etotal ke pe ebond eangle edihed eimp evdwl ecoul elong etail vol lx ly lz density pxx pyy pzz pxy pxz pyz
thermo_modify flush yes
thermo 1000

run 1000000
unfix md4
unfix shake4
unfix DEF4

write_dump all custom last.dump id x y z xu yu zu vx vy vz fx fy fz modify sort id

thermo_style custom step time temp press enthalpy etotal ke pe ebond eangle edihed eimp evdwl ecoul elong etail vol lx ly lz density pxx pyy pzz pxy pxz pyz
thermo_modify flush yes
write_data last.data
quit
